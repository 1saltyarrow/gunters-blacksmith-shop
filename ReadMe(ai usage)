3. The JavaScript Code (script.js)

This script listens for form submissions, stores transactions in an array, updates the total balance, and dynamically renders the transaction history on the page.
javascript
const balanceEl = document.getElementById('balance');
const formEl = document.getElementById('transaction-form');
const descEl = document.getElementById('desc');
const amountEl = document.getElementById('amount');
const typeEl = document.getElementById('type');
const listEl = document.getElementById('transaction-list');

// Array to store transactions
let transactions = [];

// Handle form submit
formEl.addEventListener('submit', function (e) {
  e.preventDefault();

  const description = descEl.value.trim();
  let rawAmount = parseFloat(amountEl.value);
  const transactionType = typeEl.value;

  if (!description || isNaN(rawAmount)) return;

  // Make amount negative if it's an expense
  const finalAmount = transactionType === 'expense' ? -Math.abs(rawAmount) : Math.abs(rawAmount);

  const transaction = {
    id: Date.now(),
    description,
    amount: finalAmount,
    type: transactionType
  };

  transactions.push(transaction);
  updateWallet();
  formEl.reset();
});

// Update balance and render list
function updateWallet() {
  // Calculate total balance
  const total = transactions.reduce((acc, item) => acc + item.amount, 0);
  balanceEl.textContent = `$${total.toFixed(2)}`;

  // Clear and rebuild transaction list
  listEl.innerHTML = '';
  transactions.forEach((item) => {
    const li = document.createElement('li');
    li.classList.add(item.type);
    li.innerHTML = `
      <span>${item.description}</span>
      <span>${item.amount >= 0 ? '+' : ''}$${item.amount.toFixed(2)}</span>
    `;
    listEl.appendChild(li);
  });
} -->


